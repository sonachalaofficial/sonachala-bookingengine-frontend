# ============================================================
# Sonachala Booking Engine - Environment Variables
# ============================================================
# Copy this file to .env and replace with your actual values.
# NEVER commit the real .env file (it is gitignored).

# --- User Firebase (React app) ---
# Used by src/firebase/firebase.user.js and src/core/firebase/config.user.js
# Get these from Firebase Console -> Project settings -> General -> Your apps -> SDK setup and configuration
VITE_USER_FIREBASE_API_KEY=your_firebase_api_key
VITE_USER_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_USER_FIREBASE_PROJECT_ID=your-project-id
VITE_USER_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_USER_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_USER_FIREBASE_APP_ID=1:your_messaging_sender_id:web:your_app_id

# --- Hotel Configuration ---
VITE_HOTEL_UPI_ID=your_actual_upi_id_here
